# Azure HorizonDB
AZURE_PG_HOST=
AZURE_PG_NAME=
AZURE_PG_USER=
AZURE_PG_PASSWORD=
AZURE_PG_PORT=5432
AZURE_PG_SSLMODE=require

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small
EMBEDDING_MODEL_ALIAS=horizonship-embedding

# Select model invocation per operation: azure_openai or horizondb
CHAT_PROVIDER=azure_openai
CHAT_MODEL_ALIAS=horizonship-chat
EMBEDDING_PROVIDER=azure_openai
MODEL_TIMEOUT_SECONDS=45
SEARCH_TIMEZONE=Asia/Seoul
CAPTURE_QUERY_PLAN=false

# Connection pool
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10